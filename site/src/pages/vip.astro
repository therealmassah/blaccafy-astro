---
import BaseLayout from '../layouts/BaseLayout.astro';
import AnimatedBackdrop from '../components/AnimatedBackdrop.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import {
  leadWebhookUrl,
  vipBullets,
  vipCheckoutUrl,
  vipCopy,
  vipSubtitle,
  vipTitle
} from '../data/landing';
import '../styles/global.css';
---

<BaseLayout
  title="Blaccafy VIP"
  description="Le cercle privé des vrais fans de Spykher. Avant-premières, contenus réservés et proximité sans bruit inutile."
>
  <AnimatedBackdrop slot="backdrop" />
  <SiteHeader slot="header" />

  <section class="relative z-10 flex items-center justify-center min-h-screen w-full px-4 pt-28 pb-16">
    <div class="max-w-6xl mx-auto w-full">
      <a href="/" class="inline-flex items-center text-sm text-gray-400 hover:text-white transition-colors mb-5">
        ← Retour à la page principale
      </a>

      <div class="grid gap-8 lg:grid-cols-[1.1fr_0.9fr] items-stretch">
        <div class="glass-panel rounded-3xl p-8 md:p-10 h-full">
          <p class="text-xs uppercase tracking-[0.28em] text-amber-200/70 mb-4">
            Super supporters
          </p>

          <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight text-white leading-tight max-w-2xl">
            {vipTitle}
          </h1>

          <p class="mt-4 text-xl md:text-2xl font-semibold text-white/88 leading-snug max-w-2xl">
            {vipSubtitle}
          </p>

          <p class="mt-5 text-base md:text-lg text-gray-300 leading-relaxed max-w-2xl">
            {vipCopy}
          </p>

          <div class="mt-7 flex flex-wrap gap-3">
            {vipBullets.map((pill) => (
              <span class="min-w-0 px-3 py-1 rounded-full bg-white/10 border border-white/10 text-sm text-gray-100 text-center whitespace-normal sm:whitespace-nowrap">
                {pill}
              </span>
            ))}
          </div>

          <div class="mt-8 flex flex-col gap-3 max-w-xl">
            <a
              href={vipCheckoutUrl}
              class="cta-button inline-flex items-center justify-center rounded-lg px-5 py-3 font-semibold text-white text-center"
            >
              Entrer dans Blaccafy par l'accès VIP à 19€/mois
            </a>
          </div>

          <p class="mt-4 text-xs text-gray-400">
            Pensé pour les fans qui veulent recevoir l'essentiel en avance et entrer dans le Cercle.
          </p>

          <div class="mt-10 grid gap-3 sm:grid-cols-2 items-stretch">
            <div class="rounded-2xl border border-white/10 bg-white/5 p-4 h-full">
              <p class="text-xs uppercase tracking-[0.22em] text-amber-200/70 mb-2">Pourquoi le VIP existe</p>
              <ul class="space-y-1.5 text-sm text-gray-300 leading-relaxed">
                <li>• Pour une expérience exclusive</li>
                <li>• Pour un contact privilégié</li>
                <li>• Apporter plus que de la valeur artistique.</li>
              </ul>
            </div>
            <div class="rounded-2xl border border-white/10 bg-white/5 p-4 h-full">
              <p class="text-xs uppercase tracking-[0.22em] text-amber-200/70 mb-2">Le cercle - Le Squad</p>
              <ul class="space-y-1.5 text-sm text-gray-300 leading-relaxed">
                <li>• Communauté privée</li>
                <li>• Drops et bonus réservés</li>
                <li>• Expérience plus immersive et proche du projet</li>
              </ul>
            </div>
          </div>
        </div>

        <aside class="glass-panel rounded-3xl p-8 md:p-10 sticky top-28 h-full">
          <div class="rounded-3xl border border-white/10 bg-white/5 p-5 mb-6">
            <p class="text-xs uppercase tracking-[0.22em] text-amber-200/70 mb-2">Pourquoi rejoindre maintenant</p>
            <ul class="space-y-2 text-sm text-gray-300 leading-relaxed">
              <li>• Soutenir un artiste Dancehall</li>
              <li>• Vivre une expérience fan inédite</li>
              <li>• Accéder au Shxtta Bxss Squad</li>
              <li>• Revivre l'époque Dancehall Underground</li>
            </ul>
          </div>

          <p class="text-xs uppercase tracking-[0.28em] text-amber-200/70 mb-4">
            Ce que tu reçois
          </p>

          <div class="space-y-3">
            <div class="rounded-2xl border border-white/10 bg-white/5 px-4 py-3 text-sm text-gray-100">
              Sessions lives d'Avant-premières
            </div>
            <div class="rounded-2xl border border-white/10 bg-white/5 px-4 py-3 text-sm text-gray-100">
              Accès anticipé Contenus exclusifs
            </div>
            <div class="rounded-2xl border border-white/10 bg-white/5 px-4 py-3 text-sm text-gray-100">
              Versions commentées et bonus privés
            </div>
            <div class="rounded-2xl border border-white/10 bg-white/5 px-4 py-3 text-sm text-gray-100">
              Accès au cercle Blaccafy VIP
            </div>
          </div>

          <div class="mt-8 rounded-2xl border border-amber-200/20 bg-amber-200/10 p-5">
            <p class="text-sm font-semibold text-white">Pour qui ?</p>
            <p class="mt-2 text-sm text-gray-300 leading-relaxed">
              Pour mes supporters, fans de dancehall, shatta et underground qui veulent être au 1er rang de mes projets, recevoir l'essentiel en exclu et suivre le mouvement.
            </p>
          </div>

          <div class="mt-5 rounded-2xl border border-white/10 bg-black/20 p-5">
            <p class="text-xs uppercase tracking-[0.22em] text-amber-200/70 mb-3">Accès</p>
            <p class="text-sm text-gray-300 leading-relaxed">
              Tu peux t'abonner directement et accéder au Blaccafy VIP sans engagement.
            </p>
          </div>
        </aside>
      </div>

      <div id="what-you-get" class="mt-8 grid gap-6 lg:grid-cols-2">
        <div class="glass-panel rounded-3xl p-8">
          <p class="text-xs uppercase tracking-[0.28em] text-amber-200/70 mb-4">
            Ce que tu reçois
          </p>
          <h2 class="text-2xl md:text-3xl font-semibold tracking-tight text-white leading-tight whitespace-normal md:whitespace-nowrap">
            Le meilleur endroit pour ne rien rater
          </h2>
          <p class="mt-4 text-gray-300 leading-relaxed">
            Le VIP existe pour te donner un accès rapproché et exclusif à moi et mes projets sans distraction ni intermédiaire. Tu reçois ce qui compte en direct, en avance, dans un cadre privé et plus intime.
          </p>
          <p class="mt-4 text-gray-300 leading-relaxed">
            Tu pourras influencer mes choix et contribuer activement à chacun de mes projets.
          </p>
          <div class="mt-5 flex flex-wrap gap-2">
            <span class="px-3 py-1 rounded-full bg-white/10 border border-white/10 text-sm text-gray-100">Contenus exclusifs</span>
            <span class="px-3 py-1 rounded-full bg-white/10 border border-white/10 text-sm text-gray-100">Cercle privé</span>
            <span class="px-3 py-1 rounded-full bg-white/10 border border-white/10 text-sm text-gray-100">Bonus réservés</span>
          </div>
        </div>

        <div class="glass-panel rounded-3xl p-8">
          <p class="text-xs uppercase tracking-[0.28em] text-amber-200/70 mb-4">Ce que ça change pour toi</p>
          <div class="space-y-4">
            <blockquote class="rounded-2xl border border-white/10 bg-white/5 p-5">
              <p class="text-base md:text-lg text-white/90 leading-relaxed">“Je te suis depuis les freestyles à la Défense, c'est fort de voir l'évolution à tous les niveaux.”</p>
              <footer class="mt-3 text-sm text-gray-400">Joan D.</footer>
            </blockquote>
            <blockquote class="rounded-2xl border border-white/10 bg-white/5 p-5">
              <p class="text-base md:text-lg text-white/90 leading-relaxed">“Dès les premiers freestyles, j'avais capté que t'étais différent ! C'est confirmé ! ”</p>
              <footer class="mt-3 text-sm text-gray-400">Kenny M.</footer>
            </blockquote>
          </div>
        </div>
      </div>

      <div id="vip-form" class="mt-8 glass-panel rounded-3xl p-8 md:p-10">
        <div>
          <p class="text-xs uppercase tracking-[0.28em] text-amber-200/70 mb-4">
            Rejoindre le cercle
          </p>
          <h2 class="text-2xl md:text-3xl font-semibold tracking-tight text-white leading-tight">
            Laisse ton email et entre dans le VIP
          </h2>
        </div>

        <div class="mt-4 grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(280px,0.9fr)] lg:items-start">
          <div id="vip-form-state" class="relative z-10 max-w-xl">
            <form id="vip-lead-form" class="space-y-4">
              <input
                name="company"
                type="text"
                tabindex="-1"
                autocomplete="off"
                aria-hidden="true"
                class="hidden"
              >

              <input type="hidden" name="interest" value="vip">
              <input type="hidden" name="source" value="landing">

              <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                <input
                  name="firstName"
                  type="text"
                  placeholder="Prénom"
                  autocomplete="given-name"
                  class="w-full px-4 py-3 bg-white/10 border border-white/20 rounded-lg text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent backdrop-blur-sm"
                  required
                >
                <input
                  name="lastName"
                  type="text"
                  placeholder="Nom"
                  autocomplete="family-name"
                  class="w-full px-4 py-3 bg-white/10 border border-white/20 rounded-lg text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent backdrop-blur-sm"
                  required
                >
              </div>

              <input
                name="email"
                type="email"
                placeholder="Ton email"
                autocomplete="email"
                class="w-full px-4 py-3 bg-white/10 border border-white/20 rounded-lg text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent backdrop-blur-sm"
                required
              >

              <button type="submit" class="cta-button w-full py-3 px-6 rounded-lg font-semibold text-white relative overflow-hidden">
                Recevoir mon accès VIP
              </button>
            </form>

            <p class="mt-3 text-xs text-gray-400">
              Tu reçois ensuite les instructions d'accès par email.
            </p>
          </div>

          <div class="hidden lg:flex h-full items-start justify-center -mt-10">
            <div class="flex flex-col items-center justify-start gap-6 text-center max-w-xs">
              <p class="text-lg md:text-2xl uppercase tracking-[0.28em] text-amber-200/70 font-bold whitespace-nowrap">Blaccafy VIP</p>
              <div class="soul-glow relative mx-auto">
                <div class="w-48 h-48 rounded-full p-1" style="background: linear-gradient(135deg, var(--gradient-start), var(--gradient-mid), var(--gradient-end));">
                  <div class="w-full h-full rounded-full bg-black/80 flex items-center justify-center backdrop-blur-sm">
                    <svg class="w-24 h-24 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M9 18V5l12-2v13"></path>
                      <circle cx="6" cy="18" r="3"></circle>
                      <circle cx="18" cy="16" r="3"></circle>
                    </svg>
                  </div>
                </div>
                <div class="absolute inset-0 rounded-full blur-xl" style="background: linear-gradient(135deg, rgba(95,15,47,0.55), rgba(176,18,75,0.38), rgba(212,175,55,0.26));"></div>
              </div>
            </div>
          </div>
        </div>

        <div id="vip-success" class="hidden mt-8 max-w-xl">
          <h2 class="text-2xl font-semibold tracking-tight mb-3 text-white">
            Ton accès VIP est enregistré
          </h2>
          <p class="text-gray-300 leading-relaxed">
            Tu vas recevoir le suivi par email avec les instructions d'entrée et les liens utiles.
          </p>
        </div>

        <div id="vip-error" class="hidden mt-8 max-w-xl">
          <h2 class="text-2xl font-semibold tracking-tight mb-3 text-white">
            On a bloqué l'envoi
          </h2>
          <p class="text-gray-300 leading-relaxed">
            Réessaie dans un instant.
          </p>
          <button type="button" id="vip-retry" class="mt-4 cta-button w-full py-3 px-6 rounded-lg font-semibold text-white relative overflow-hidden">
            Réessayer
          </button>
        </div>
      </div>

      <div class="mt-8 glass-panel rounded-3xl p-8 md:p-10 text-center">
        <p class="text-xs uppercase tracking-[0.28em] text-amber-200/70 mb-4">
          Dernier appel
        </p>
        <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight text-white leading-tight">
          Entre dans le VIP et reste plus près du projet
        </h2>
        <p class="mt-4 text-gray-300 max-w-2xl mx-auto leading-relaxed">
          Si tu veux accéder à mon univers de façon exclusive et privée, le VIP est fait pour toi.
          <br>
          Shxtta Bxss Squad la Communauté et Blaccafy VIP, la musique qui l'accompagne.
        </p>
      </div>
    </div>
  </section>

  <SiteFooter slot="footer" />
</BaseLayout>

<script is:inline define:vars={{ leadWebhookUrl }}>
  const form = document.getElementById('vip-lead-form');
  const vipFormState = document.getElementById('vip-form-state');
  const vipSuccess = document.getElementById('vip-success');
  const vipError = document.getElementById('vip-error');
  const vipRetry = document.getElementById('vip-retry');
  const formOpenedAt = Date.now();

  const showState = (state) => {
    vipFormState?.classList.toggle('hidden', state !== 'form');
    vipSuccess?.classList.toggle('hidden', state !== 'success');
    vipError?.classList.toggle('hidden', state !== 'error');
  };

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();

    if (form.dataset.submitting === 'true') {
      return;
    }

    form.dataset.submitting = 'true';

    const button = form.querySelector('button[type="submit"]');
    const formData = new FormData(form);
    const honeypot = String(formData.get('company') ?? '').trim();
    const tooFast = Date.now() - formOpenedAt < 2000;

    if (honeypot || tooFast) {
      return;
    }

    if (button) {
      button.setAttribute('disabled', 'true');
      button.textContent = 'Envoi...';
    }

    try {
      await fetch(leadWebhookUrl, {
        method: 'POST',
        mode: 'no-cors',
        body: new URLSearchParams(formData)
      });
      showState('success');
      form.reset();
    } catch (error) {
      console.error('Blaccafy VIP webhook failed', error);
      form.dataset.submitting = 'false';
      showState('error');
      if (button) {
        button.removeAttribute('disabled');
        button.textContent = 'Réessayer';
      }
    }
  });

  vipRetry?.addEventListener('click', () => {
    form.dataset.submitting = 'false';
    showState('form');
    const button = form?.querySelector('button[type="submit"]');
    if (button) {
      button.removeAttribute('disabled');
      button.textContent = 'Recevoir mon accès VIP';
    }
  });
</script>
