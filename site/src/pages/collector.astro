---
import BaseLayout from '../layouts/BaseLayout.astro';
import AnimatedBackdrop from '../components/AnimatedBackdrop.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import {
  collectorCheckoutUrl,
  collectorFaq,
  collectorHeroPills,
  collectorIncludes,
  collectorLeadCopy,
  collectorParentBenefits,
  collectorTitle
} from '../data/landing';
import '../styles/global.css';
---

<BaseLayout
  title="Blaccafy Collector"
  description="Pack Shatta Kids Collector de Blaccafy: EP, cahier d'activité enfant, objet collector physique et expérience privée à 97€."
>
  <AnimatedBackdrop slot="backdrop" />
  <SiteHeader slot="header" />

  <section class="relative z-10 flex items-center justify-center min-h-screen w-full px-4 pt-28 pb-16">
    <div class="max-w-6xl mx-auto w-full">
      <a href="/" class="inline-flex items-center text-sm text-gray-400 hover:text-white transition-colors mb-5">
        ← Retour à la page principale
      </a>

      <div class="grid gap-8 lg:grid-cols-[1.12fr_0.88fr] items-start">
        <div class="glass-panel rounded-3xl p-8 md:p-10">
          <p class="text-xs uppercase tracking-[0.28em] text-amber-200/70 mb-4">
            Pack collector physique
          </p>

          <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight text-white leading-tight max-w-2xl">
            {collectorTitle}
          </h1>

          <p class="mt-4 text-xl md:text-2xl font-semibold text-white/90 leading-snug max-w-2xl">
            Le bundle Shatta Kids pensé pour les parents fans qui veulent un objet collector utile, musical et familial.
          </p>

          <p class="mt-5 text-base md:text-lg text-gray-300 leading-relaxed max-w-2xl whitespace-pre-line">
            {collectorLeadCopy}
          </p>

          <div class="mt-7 flex flex-wrap gap-3">
            {collectorHeroPills.map((pill) => (
              <span class="px-3 py-1 rounded-full bg-white/10 border border-white/10 text-sm text-gray-100 whitespace-nowrap">
                {pill}
              </span>
            ))}
          </div>

          <div class="mt-8 flex flex-col gap-3 max-w-xl">
            <a
              href={collectorCheckoutUrl}
              class="cta-button inline-flex items-center justify-center rounded-lg px-5 py-3 font-semibold text-white text-center"
            >
              Commander le Pack Shatta Kids Collector à 97€
            </a>
          </div>

          <p class="mt-4 text-xs text-gray-400">
            Objet collector physique • Expérience privée • Accès direct en session live visio
          </p>

          <div class="mt-10 grid gap-3 sm:grid-cols-2">
            <div class="rounded-2xl border border-white/10 bg-white/5 p-5">
              <p class="text-xs uppercase tracking-[0.22em] text-amber-200/70 mb-2">Pourquoi ce pack existe</p>
              <ul class="space-y-2 text-sm text-gray-300 leading-relaxed">
                <li>• Pour les fans qui sont aussi parents</li>
                <li>• Pour occuper l'enfant de façon ludique</li>
                <li>• Pour transmettre tôt ce qu'on a appris tard</li>
                <li>• Pour garder un objet collector physique</li>
              </ul>
            </div>
            <div class="rounded-2xl border border-white/10 bg-white/5 p-5">
              <p class="text-xs uppercase tracking-[0.22em] text-amber-200/70 mb-2">L'expérience</p>
              <ul class="space-y-2 text-sm text-gray-300 leading-relaxed">
                <li>• Accès direct à une session live visio</li>
                <li>• Moment privé avec moi et ma fille</li>
                <li>• Expérience simple, utile et mémorable</li>
                <li>• Pack pensé pour durer au-delà du moment d'écoute</li>
              </ul>
            </div>
          </div>
        </div>

        <aside class="glass-panel rounded-3xl p-8 md:p-10 sticky top-28 h-full">
          <div class="rounded-3xl border border-white/10 bg-white/5 p-5 mb-6">
            <p class="text-xs uppercase tracking-[0.22em] text-amber-200/70 mb-2">Ce que contient le pack</p>
            <div class="space-y-3">
              {collectorIncludes.map((item) => (
                <div class="rounded-2xl border border-white/10 bg-white/5 px-4 py-3 text-sm text-gray-100">
                  {item}
                </div>
              ))}
            </div>
          </div>

          <div class="rounded-2xl border border-amber-200/20 bg-amber-200/10 p-5">
            <p class="text-sm font-semibold text-white">Pour qui ?</p>
            <p class="mt-2 text-sm text-gray-300 leading-relaxed">
              Pour mes fans, mes supporters et les parents qui veulent un bundle collector qui fasse plaisir à l'enfant tout en gardant le lien avec mon univers.
            </p>
          </div>

          <div class="mt-5 rounded-2xl border border-white/10 bg-black/20 p-5">
            <p class="text-xs uppercase tracking-[0.22em] text-amber-200/70 mb-3">Le vrai bénéfice</p>
            <p class="text-sm text-gray-300 leading-relaxed">
              Un pack qui combine musique, activité et lien direct. Tu n'achètes pas juste un produit, tu entres dans un moment privé pensé pour la famille.
            </p>
          </div>

          <div class="mt-5 rounded-2xl border border-white/10 bg-black/20 p-5">
            <p class="text-xs uppercase tracking-[0.22em] text-amber-200/70 mb-3">Prix</p>
            <p class="text-3xl font-extrabold tracking-tight text-white">97€</p>
            <p class="mt-2 text-sm text-gray-300 leading-relaxed">
              Pack Shatta Kids Collector disponible via Stripe.
            </p>
          </div>
        </aside>
      </div>

      <div class="mt-8 grid gap-6 lg:grid-cols-2">
        <div class="glass-panel rounded-3xl p-8">
          <p class="text-xs uppercase tracking-[0.28em] text-amber-200/70 mb-4">
            Ce que le cahier apporte
          </p>
          <h2 class="text-2xl md:text-3xl font-semibold tracking-tight text-white leading-tight">
            Un outil pour divertir, apprendre et partager
          </h2>
          <p class="mt-4 text-gray-300 leading-relaxed">
            Le cahier d'activité Blacc Diamond Kids aide les parents à occuper leur enfant de façon ludique, à créer un moment calme à la maison et à donner tôt des repères utiles.
          </p>
          <div class="mt-5 flex flex-wrap gap-2">
            {collectorParentBenefits.map((item) => (
              <span class="px-3 py-1 rounded-full bg-white/10 border border-white/10 text-sm text-gray-100">
                {item}
              </span>
            ))}
          </div>
        </div>

        <div class="glass-panel rounded-3xl p-8">
          <p class="text-xs uppercase tracking-[0.28em] text-amber-200/70 mb-4">
            Lecture simple
          </p>
          <div class="space-y-4">
            <blockquote class="rounded-2xl border border-white/10 bg-white/5 p-5">
              <p class="text-base md:text-lg text-white/90 leading-relaxed">
                “Tu offres un moment musical, un support d'activité et un accès direct à l'univers Blaccafy dans un seul pack.”
              </p>
            </blockquote>
            <blockquote class="rounded-2xl border border-white/10 bg-white/5 p-5">
              <p class="text-base md:text-lg text-white/90 leading-relaxed">
                “Le produit parle aux parents fans qui veulent du concret pour la maison et un objet collector à garder.”
              </p>
            </blockquote>
          </div>
        </div>
      </div>

      <div class="mt-8 grid gap-4 md:grid-cols-3">
        {collectorFaq.map((item) => (
          <div class="glass-panel rounded-3xl p-6">
            <p class="text-sm uppercase tracking-[0.22em] text-amber-200/70 mb-3">FAQ</p>
            <h3 class="text-lg font-semibold text-white leading-snug">{item.q}</h3>
            <p class="mt-3 text-sm text-gray-300 leading-relaxed">{item.a}</p>
          </div>
        ))}
      </div>

      <div class="mt-8 glass-panel rounded-3xl p-8 md:p-10 text-center">
        <p class="text-xs uppercase tracking-[0.28em] text-amber-200/70 mb-4">
          Commander maintenant
        </p>
        <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight text-white leading-tight">
          Rejoins le Shatta Kids Collector et offre un vrai moment Blaccafy à la maison.
        </h2>
        <p class="mt-4 text-gray-300 max-w-2xl mx-auto leading-relaxed">
          Le pack est pensé comme un objet collector physique avec une expérience privée et un accès direct en session live visio.
        </p>
        <div class="mt-6 flex flex-col sm:flex-row gap-3 justify-center">
          <a
            href={collectorCheckoutUrl}
            class="cta-button inline-flex items-center justify-center rounded-lg px-6 py-3 font-semibold text-white text-center"
          >
            Aller au paiement Stripe à 97€
          </a>
          <a
            href="/"
            class="inline-flex items-center justify-center rounded-lg border border-white/15 bg-white/5 px-6 py-3 font-semibold text-white hover:bg-white/10 transition-all"
          >
            Revenir à la page principale
          </a>
        </div>
      </div>
    </div>
  </section>

  <SiteFooter slot="footer" />
</BaseLayout>
