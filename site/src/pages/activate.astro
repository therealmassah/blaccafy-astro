---
import BaseLayout from '../layouts/BaseLayout.astro';
import AnimatedBackdrop from '../components/AnimatedBackdrop.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { navidromeActivationUrl } from '../data/landing';
import '../styles/global.css';

const email = Astro.url.searchParams.get('email') ?? '';
const token = Astro.url.searchParams.get('token') ?? '';
---

<BaseLayout
  title="Activation Blaccafy"
  description="Active ton accès Blaccafy avec un mot de passe personnel et un lien unique."
>
  <AnimatedBackdrop slot="backdrop" />
  <SiteHeader slot="header" />

  <section class="relative z-10 flex items-center justify-center min-h-screen w-full px-4 pt-28 pb-16">
    <div class="max-w-3xl mx-auto w-full">
      <a href="/" class="inline-flex items-center text-sm text-gray-400 hover:text-white transition-colors mb-5">
        ← Retour à la page principale
      </a>

      <div class="glass-panel rounded-3xl p-8 md:p-10">
        <p class="text-xs uppercase tracking-[0.28em] text-amber-200/70 mb-4">
          Accès privé
        </p>

        <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight text-white leading-tight max-w-2xl">
          Active ton accès Blaccafy
        </h1>

        <p class="mt-4 text-xl text-white/85 font-semibold leading-snug max-w-2xl text-center">
          Choisis maintenant ton mot de passe personnel.
        </p>

        <p class="mt-5 text-base md:text-lg text-gray-300 leading-relaxed max-w-2xl text-center">
          Ce lien prépare ton compte Blaccafy.<br>
          Tu définis ton mot de passe, puis tu utilises<br>
          ensuite l’accès habituel avec ton email.
        </p>

        <div id="activation-state" class="mt-8 max-w-xl">
          <form id="activation-form" class="space-y-4">
            <input name="email" type="hidden" value={email}>
            <input name="token" type="hidden" value={token}>

            <div class="rounded-2xl border border-white/10 bg-white/5 p-4 text-sm text-gray-300 leading-relaxed">
              <p class="font-semibold text-white">Règles simples</p>
              <ul class="mt-2 space-y-1">
                <li>• 12 caractères minimum</li>
                <li>• Un mot de passe que tu gardes pour toi</li>
                <li>• Un seul passage suffit</li>
              </ul>
            </div>

            <input
              name="password"
              type="password"
              placeholder="Nouveau mot de passe"
              autocomplete="new-password"
              class="w-full px-4 py-3 bg-white/10 border border-white/20 rounded-lg text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent backdrop-blur-sm"
              required
              minlength="12"
            >

            <input
              name="confirmPassword"
              type="password"
              placeholder="Confirmer le mot de passe"
              autocomplete="new-password"
              class="w-full px-4 py-3 bg-white/10 border border-white/20 rounded-lg text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent backdrop-blur-sm"
              required
              minlength="12"
            >

            <button type="submit" class="cta-button w-full py-3 px-6 rounded-lg font-semibold text-white relative overflow-hidden">
              Activer mon accès
            </button>
          </form>

          <p id="activation-help" class="mt-3 text-xs text-gray-400">
            Le lien arrive depuis ton email d’accès. Si tu n’as rien, vérifie tes spams.
          </p>
        </div>

        <div id="activation-success" class="hidden mt-8 max-w-xl rounded-2xl border border-emerald-400/20 bg-emerald-400/10 p-5">
          <h2 class="text-2xl font-semibold tracking-tight mb-3 text-white">
            Accès activé
          </h2>
          <p class="text-gray-300 leading-relaxed">
            Ton mot de passe est prêt. Ouvre Navidrome avec ton email et le mot de passe que tu viens de définir.
          </p>
        </div>

        <div id="activation-error" class="hidden mt-8 max-w-xl rounded-2xl border border-red-400/20 bg-red-400/10 p-5 text-center">
          <h2 class="text-2xl font-semibold tracking-tight mb-3 text-white">
            Activation bloquée
          </h2>
          <p id="activation-error-text" class="text-gray-300 leading-relaxed">
            Réessaie avec un lien valide.
          </p>
          <button type="button" id="activation-retry" class="mt-4 cta-button w-full py-3 px-6 rounded-lg font-semibold text-white relative overflow-hidden">
            Réessayer
          </button>
        </div>
      </div>
    </div>
  </section>

  <SiteFooter slot="footer" />
</BaseLayout>

<script is:inline define:vars={{ navidromeActivationUrl }}>
  const form = document.getElementById('activation-form');
  const state = document.getElementById('activation-state');
  const success = document.getElementById('activation-success');
  const error = document.getElementById('activation-error');
  const errorText = document.getElementById('activation-error-text');
  const retry = document.getElementById('activation-retry');
  const emailField = form?.querySelector('input[name="email"]');
  const tokenField = form?.querySelector('input[name="token"]');
  const params = new URLSearchParams(window.location.search);
  const emailValue = String(emailField?.value || params.get('email') || '').trim();
  const tokenValue = String(tokenField?.value || params.get('token') || '').trim();

  if (emailField && emailValue) {
    emailField.value = emailValue;
  }

  if (tokenField && tokenValue) {
    tokenField.value = tokenValue;
  }

  const showState = (value) => {
    state?.classList.toggle('hidden', value !== 'form');
    success?.classList.toggle('hidden', value !== 'success');
    error?.classList.toggle('hidden', value !== 'error');
  };

  const issueToken = async () => {
    if (!emailValue) {
      throw new Error('Le lien d’activation est incomplet.');
    }

    const response = await fetch(navidromeActivationUrl.replace(/\/activate$/, '/activate/start'), {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email: emailValue })
    });
    const payload = await response.json();

    if (!response.ok || !payload.ok) {
      throw new Error(payload.error || 'Activation failed');
    }

    tokenField.value = payload.activationToken;
  };

  if (!tokenValue) {
    issueToken().catch((error) => {
      errorText.textContent = error instanceof Error ? error.message : 'Réessaie dans un instant.';
      showState('error');
    });
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();

    if (form.dataset.submitting === 'true') {
      return;
    }

    form.dataset.submitting = 'true';

    const button = form.querySelector('button[type="submit"]');
    const formData = new FormData(form);
    const token = String(formData.get('token') ?? '').trim();
    const password = String(formData.get('password') ?? '');
    const confirmPassword = String(formData.get('confirmPassword') ?? '');

    if (!token) {
      errorText.textContent = 'Le lien d’activation est incomplet.';
      form.dataset.submitting = 'false';
      showState('error');
      return;
    }

    if (password !== confirmPassword) {
      errorText.textContent = 'Les mots de passe ne correspondent pas.';
      form.dataset.submitting = 'false';
      showState('error');
      return;
    }

    if (button) {
      button.setAttribute('disabled', 'true');
      button.textContent = 'Activation...';
    }

    try {
      const response = await fetch('/api/activate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ token, password })
      });
      const payload = await response.json();

      if (!response.ok || !payload.ok) {
        throw new Error(payload.error || 'Activation failed');
      }

      showState('success');
      form.reset();
    } catch (error) {
      errorText.textContent = error instanceof Error ? error.message : 'Réessaie dans un instant.';
      form.dataset.submitting = 'false';
      showState('error');
      if (button) {
        button.removeAttribute('disabled');
        button.textContent = 'Réessayer';
      }
    }
  });

  retry?.addEventListener('click', () => {
    form.dataset.submitting = 'false';
    showState('form');
    const button = form?.querySelector('button[type="submit"]');
    if (button) {
      button.removeAttribute('disabled');
      button.textContent = 'Activer mon accès';
    }
  });
</script>
