---
import { leadWebhookUrl } from '../data/landing';

const {
  eyebrow,
  title,
  subtitle,
  copy,
  bullets = [],
  interest,
  ctaLabel,
  successTitle,
  successCopy,
  nextHref = '',
  nextLabel = 'Continuer vers le paiement',
  backHref = '/',
  backLabel = 'Retour à la page principale'
} = Astro.props;
---

<section class="relative z-10 flex items-center justify-center min-h-screen w-full px-4 pt-28 pb-14">
  <div class="max-w-3xl mx-auto w-full">
    <a href={backHref} class="inline-flex items-center text-sm text-gray-300 hover:text-white transition-colors mb-6">
      ← {backLabel}
    </a>

    <div class="glass-panel rounded-3xl p-8 md:p-10">
      <p class="text-xs uppercase tracking-[0.28em] text-amber-200/70 mb-4">
        {eyebrow}
      </p>
      <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight text-white leading-tight">
        {title}
      </h1>
      <p class="mt-4 text-xl text-white/85 font-semibold leading-snug">
        {subtitle}
      </p>
      <p class="mt-5 text-base md:text-lg text-gray-300 leading-relaxed max-w-2xl">
        {copy}
      </p>

      <div class="mt-7 flex flex-wrap gap-3">
        {bullets.map((item) => (
          <span class="px-3 py-1 rounded-full bg-white/10 border border-white/10 text-sm text-gray-100">
            {item}
          </span>
        ))}
      </div>

      <div id="capture-form-state" class="mt-8">
        <form id="capture-lead-form" class="space-y-4 max-w-xl">
          <input
            name="company"
            type="text"
            tabindex="-1"
            autocomplete="off"
            aria-hidden="true"
            class="hidden"
          >

          <input type="hidden" name="interest" value={interest}>
          <input type="hidden" name="source" value="landing">

          <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
            <input
              name="firstName"
              type="text"
              placeholder="Prénom"
              autocomplete="given-name"
              class="w-full px-4 py-3 bg-white/10 border border-white/20 rounded-lg text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent backdrop-blur-sm"
              required
            >
            <input
              name="lastName"
              type="text"
              placeholder="Nom"
              autocomplete="family-name"
              class="w-full px-4 py-3 bg-white/10 border border-white/20 rounded-lg text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent backdrop-blur-sm"
              required
            >
          </div>

          <input
            name="email"
            type="email"
            placeholder="Ton email"
            autocomplete="email"
            class="w-full px-4 py-3 bg-white/10 border border-white/20 rounded-lg text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent backdrop-blur-sm"
            required
          >

          <button type="submit" class="cta-button w-full py-3 px-6 rounded-lg font-semibold text-white relative overflow-hidden">
            {ctaLabel}
          </button>
        </form>

        <p class="mt-3 text-xs text-gray-400">
          Tu reçois ensuite l'accès au paiement et les instructions d'entrée.
        </p>
      </div>

      <div id="capture-success" class="hidden mt-8 max-w-xl">
        <h2 class="text-2xl font-semibold tracking-tight mb-3 text-white">
          {successTitle}
        </h2>
        <p class="text-gray-300 leading-relaxed">
          {successCopy}
        </p>
        {nextHref ? (
          <a
            id="capture-next-link"
            href={nextHref}
            class="mt-5 cta-button w-full py-3 px-6 rounded-lg font-semibold text-white relative overflow-hidden text-center block"
          >
            {nextLabel}
          </a>
        ) : (
          <p class="mt-5 text-sm text-amber-200/80">
            L'URL Stripe est à brancher via `PUBLIC_STUDIO_STRIPE_CHECKOUT_URL`.
          </p>
        )}
      </div>

      <div id="capture-error" class="hidden mt-8 max-w-xl">
        <h2 class="text-2xl font-semibold tracking-tight mb-3 text-white">
          On a bloqué l'envoi
        </h2>
        <p class="text-gray-300 leading-relaxed">
          Réessaie dans un instant.
        </p>
        <button type="button" id="capture-retry" class="mt-4 cta-button w-full py-3 px-6 rounded-lg font-semibold text-white relative overflow-hidden">
          Réessayer
        </button>
      </div>
    </div>
  </div>
</section>

<script is:inline define:vars={{ leadWebhookUrl, nextHref }}>
  const form = document.getElementById('capture-lead-form');
  const captureFormState = document.getElementById('capture-form-state');
  const captureSuccess = document.getElementById('capture-success');
  const captureError = document.getElementById('capture-error');
  const captureRetry = document.getElementById('capture-retry');
  const formOpenedAt = Date.now();

  const showState = (state) => {
    captureFormState?.classList.toggle('hidden', state !== 'form');
    captureSuccess?.classList.toggle('hidden', state !== 'success');
    captureError?.classList.toggle('hidden', state !== 'error');
  };

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();

    if (form.dataset.submitting === 'true') {
      return;
    }

    form.dataset.submitting = 'true';

    const button = form.querySelector('button[type="submit"]');
    const formData = new FormData(form);
    const honeypot = String(formData.get('company') ?? '').trim();
    const tooFast = Date.now() - formOpenedAt < 2000;

    if (honeypot || tooFast) {
      return;
    }

    if (button) {
      button.setAttribute('disabled', 'true');
      button.textContent = 'Envoi...';
    }

    try {
      await fetch(leadWebhookUrl, {
        method: 'POST',
        mode: 'no-cors',
        body: new URLSearchParams(formData)
      });
      showState('success');
      form.reset();
      if (nextHref) {
        window.setTimeout(() => {
          window.location.href = nextHref;
        }, 1100);
      }
    } catch (error) {
      console.error('Blaccafy capture webhook failed', error);
      form.dataset.submitting = 'false';
      showState('error');
      if (button) {
        button.removeAttribute('disabled');
        button.textContent = 'Réessayer';
      }
    }
  });

  captureRetry?.addEventListener('click', () => {
    form.dataset.submitting = 'false';
    showState('form');
    const button = form?.querySelector('button[type="submit"]');
    if (button) {
      button.removeAttribute('disabled');
      button.textContent = 'Réessayer';
    }
  });
</script>
