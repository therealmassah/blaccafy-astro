---
import { archiveTags, collectorBullets, collectorCopy, collectorTitle, dropSessionBullets, dropSessionCopy, dropSessionTitle, featurePills, leadWebhookUrl, vaultCheckoutUrl } from '../data/landing';
---

<section class="relative z-10 flex items-center justify-center min-h-screen w-full px-4 pt-32 pb-16">
  <div class="max-w-4xl mx-auto flex flex-col items-center text-center">
    <div class="soul-glow mb-8 relative">
      <div class="w-32 h-32 rounded-full p-1" style="background: linear-gradient(135deg, #5f0f2f, #d946ef 52%, #d4af37);">
        <div class="w-full h-full rounded-full bg-black/80 flex items-center justify-center backdrop-blur-sm">
          <svg class="w-16 h-16 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M9 18V5l12-2v13"></path>
            <circle cx="6" cy="18" r="3"></circle>
            <circle cx="18" cy="16" r="3"></circle>
          </svg>
        </div>
      </div>
      <div class="absolute inset-0 rounded-full blur-xl" style="background: linear-gradient(135deg, rgba(95,15,47,0.55), rgba(217,70,239,0.38), rgba(212,175,55,0.26));"></div>
    </div>

    <h1 class="font-extrabold text-5xl md:text-7xl lg:text-8xl leading-[1.14] tracking-tight mb-4 pb-[0.16em]">
      <span class="inline-block text-5xl md:text-7xl lg:text-8xl font-extrabold text-transparent bg-clip-text tracking-[0.01em]" style="background: linear-gradient(135deg, #f5d36a 0%, #8b5a22 36%, #4a2a10 64%, #f1c84f 100%); -webkit-background-clip: text; background-clip: text; -webkit-text-stroke: 0.35px rgba(0,0,0,0.7); text-shadow: 0 1px 5px rgba(0,0,0,0.62), 0 0 6px rgba(80, 36, 14, 0.08); font-family: 'Montserrat', 'Arial', sans-serif; line-height: 1.08;">
        Blaccafy
      </span>
    </h1>

    <h2 class="text-2xl md:text-4xl font-semibold tracking-tight mb-6 text-white max-w-3xl mx-auto whitespace-nowrap">
      Entre dans le
      <span class="text-transparent bg-clip-text" style="background: linear-gradient(135deg, var(--gradient-mid), var(--gradient-end)); -webkit-background-clip: text; background-clip: text;">
        coffre musical privé
      </span>
      de Spykher.
    </h2>

    <p class="text-lg md:text-2xl font-light max-w-3xl mx-auto mb-5 leading-relaxed" style="color: var(--text);">
      Sons exclusifs, previews, demos, freestyles, archives.
      <br>
      Le contenu que le public n’entendra peut-être jamais.
      <br>
        <span class="font-medium text-transparent bg-clip-text" style="background: linear-gradient(135deg, var(--gradient-start), var(--gradient-end)); -webkit-background-clip: text; background-clip: text;">
          Hors algorithme. Pour les vrais supporters.
        </span>
    </p>

    <p class="text-base md:text-lg text-gray-300 max-w-2xl mx-auto mb-12 leading-relaxed">
      Tu n’es pas sur une plateforme de masse.
      <br>
      Tu entres dans un espace privé et indépendant,
      <br>
      pensé pour un cercle fermé.
    </p>

    <div id="cta" class="glass-panel join-card-hover rounded-2xl p-8 max-w-md w-full mx-auto relative overflow-hidden">
      <div id="lead-form-state" class="relative z-10">
        <h3 class="text-2xl font-semibold tracking-tight mb-4 text-center text-white">
          Rejoindre le
          <span class="text-transparent bg-clip-text" style="background: linear-gradient(135deg, var(--gradient-start), var(--gradient-end)); -webkit-background-clip: text; background-clip: text;">
            Vault
          </span>
          <span class="ml-2 text-sm font-medium text-amber-200/80">9€/mois</span>
        </h3>
        <p class="text-gray-300 mb-6 text-center">
          Accès privé au coffre.
          <br>
          Rareté, musique brute, cercle fermé.
        </p>

        <form id="blaccafy-lead-form" class="space-y-4">
          <input
            name="company"
            type="text"
            tabindex="-1"
            autocomplete="off"
            aria-hidden="true"
            class="hidden"
          >

          <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
            <input
              name="firstName"
              type="text"
              placeholder="Prénom"
              autocomplete="given-name"
              class="w-full px-4 py-3 bg-white/10 border border-white/20 rounded-lg text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent backdrop-blur-sm"
              required
            >
            <input
              name="lastName"
              type="text"
              placeholder="Nom"
              autocomplete="family-name"
              class="w-full px-4 py-3 bg-white/10 border border-white/20 rounded-lg text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent backdrop-blur-sm"
              required
            >
          </div>

          <input
            name="email"
            type="email"
            placeholder="Ton email pour l’accès privé"
            autocomplete="email"
            class="w-full px-4 py-3 bg-white/10 border border-white/20 rounded-lg text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent backdrop-blur-sm"
            required
          >

          <button type="submit" class="cta-button w-full py-3 px-6 rounded-lg font-semibold text-white relative overflow-hidden">
            Entrer dans le Vault →
          </button>
        </form>

        <p class="text-xs text-gray-400 text-center mt-4">
          Accès membres • Sons hors algorithme • Soutien direct à Spykher
        </p>
      </div>

      <div id="lead-success" class="hidden relative z-10 text-center">
        <h3 class="text-2xl font-semibold tracking-tight mb-3 text-white">
          Lead capturé
        </h3>
        <p class="text-gray-300 mb-6">
          Ton accès est parti dans GHL. Tu peux maintenant ouvrir le checkout Stripe.
        </p>
        <a
          href={vaultCheckoutUrl}
          class="cta-button w-full py-3 px-6 rounded-lg font-semibold text-white relative overflow-hidden text-center block"
        >
          Aller au checkout Vault 9€/mois →
        </a>
        <a
          href="#collector"
          class="mt-3 w-full py-3 px-6 rounded-lg font-semibold text-white/90 relative overflow-hidden text-center block border border-white/15 bg-white/5 hover:bg-white/10 transition-all"
        >
          Voir le Collector →
        </a>
        <p class="text-xs text-gray-400 text-center mt-4">
          Accès membres • Sons hors algorithme • Soutien direct à Spykher
        </p>
      </div>
    </div>

    <div class="flex flex-wrap justify-center gap-4 mt-12 max-w-2xl">
      {featurePills.map((pill, index) => (
        <div class={`glass-panel tag-glow tag-glow-${index + 1} px-4 py-2 rounded-full text-sm font-medium`}>
          <span class="tag-glow-bg"></span>
          <span class="relative z-10">{pill}</span>
        </div>
      ))}
    </div>

    <div id="vault" class="mt-8 grid gap-4 max-w-3xl w-full md:grid-cols-2">
      <div class="glass-panel rounded-2xl p-6 text-left">
        <p class="text-xs uppercase tracking-[0.28em] text-amber-200/70 mb-3">
          Manifesto
        </p>

        <h3 class="text-xl font-semibold tracking-tight text-white leading-snug">
          Si l'Indépendance avait un son, Blaccafy t'y donne accès
        </h3>
        <p class="mt-4 text-sm text-gray-300 leading-relaxed">
          Blaccafy est un coffre fort musical : privé, rare, direct. Pas une vitrine. Un accès et une preuve d'Indépendance.
        </p>
      </div>

      <div id="archives" class="glass-panel rounded-2xl p-6 text-left">
        <p class="text-xs uppercase tracking-[0.28em] text-amber-200/70 mb-3">
          Dans le coffre
        </p>
        <div class="flex flex-wrap gap-2 text-sm text-gray-200">
          {archiveTags.map((tag) => (
            <span class="px-3 py-1 rounded-full bg-white/10 border border-white/10">
              {tag}
            </span>
          ))}
        </div>
      </div>

      <div class="glass-panel rounded-2xl p-6 text-left">
        <p class="text-xs uppercase tracking-[0.28em] text-amber-200/70 mb-3">
          Offre centrale
        </p>

        <h3 class="text-xl font-semibold tracking-tight text-white leading-snug">
          Blaccafy Vault 9€/mois
        </h3>
        <p class="mt-4 text-sm text-gray-300 leading-relaxed">
          Le membership de base pour entrer dans le coffre, suivre les drops, et rester au centre du cercle.
        </p>
        <div class="mt-4 flex flex-wrap gap-2 text-sm text-gray-200">
          <span class="px-3 py-1 rounded-full bg-white/10 border border-white/10">Accès privé</span>
          <span class="px-3 py-1 rounded-full bg-white/10 border border-white/10">Contenu rare</span>
          <span class="px-3 py-1 rounded-full bg-white/10 border border-white/10">Base récurrente</span>
        </div>
      </div>

      <div id="collector" class="glass-panel rounded-2xl p-6 text-left">
        <p class="text-xs uppercase tracking-[0.28em] text-amber-200/70 mb-3">
          Upsell
        </p>

        <h3 class="text-xl font-semibold tracking-tight text-white leading-snug">
          {collectorTitle}
        </h3>
        <p class="mt-4 text-sm text-gray-300 leading-relaxed">
          {collectorCopy}
        </p>
        <div class="mt-4 flex flex-wrap gap-2 text-sm text-gray-200">
          {collectorBullets.map((item) => (
            <span class="px-3 py-1 rounded-full bg-white/10 border border-white/10">
              {item}
            </span>
          ))}
        </div>
      </div>

      <div class="glass-panel rounded-2xl p-6 text-left md:col-span-2">
        <p class="text-xs uppercase tracking-[0.28em] text-amber-200/70 mb-3">
          Premier drop
        </p>

        <h3 class="text-xl font-semibold tracking-tight text-white leading-snug">
          {dropSessionTitle}
        </h3>
        <p class="mt-4 text-sm text-gray-300 leading-relaxed max-w-3xl">
          {dropSessionCopy}
        </p>

        <div class="mt-4 flex flex-wrap gap-2 text-sm text-gray-200">
          {dropSessionBullets.map((item) => (
            <span class="px-3 py-1 rounded-full bg-white/10 border border-white/10">
              {item}
            </span>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  const form = document.getElementById('blaccafy-lead-form');
  const leadFormState = document.getElementById('lead-form-state');
  const leadSuccess = document.getElementById('lead-success');
  const formOpenedAt = Date.now();

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();

    const button = form.querySelector('button[type="submit"]');
    const formData = new FormData(form);
    formData.set('source', 'landing');
    formData.set('interest', 'music');

    const honeypot = String(formData.get('company') ?? '').trim();
    const tooFast = Date.now() - formOpenedAt < 2000;

    if (honeypot || tooFast) {
      return;
    }

    if (button) {
      button.setAttribute('disabled', 'true');
      button.textContent = 'Envoi...';
    }

    try {
      await fetch(leadWebhookUrl, {
        method: 'POST',
        mode: 'no-cors',
        body: new URLSearchParams(formData)
      });
    } finally {
      leadFormState?.classList.add('hidden');
      leadSuccess?.classList.remove('hidden');
      form.reset();
    }
  });
</script>
